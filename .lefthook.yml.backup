# =============================================================================
# Lefthook Configuration - Political Sphere Pre-Commit Hooks
# Version: 4.0.0 (Enterprise-Grade Sovereign Implementation)
# Last Updated: 2025-11-17
# Architecture: SLSA Level 3 compliant, OWASP ASVS aligned, WCAG 2.2 AA enforced
# =============================================================================
#
# GOVERNANCE CONTEXT:
# - Zero-trust security model with fail-closed enforcement
# - WCAG 2.2 AA+ accessibility mandatory (non-negotiable)
# - Political neutrality safeguards (constitutional requirement)
# - GDPR/CCPA privacy-by-design enforcement
# - Supply chain integrity (SBOM, provenance tracking)
#
# EXECUTION MODES (controlled via environment):
# - FAST_AI=1      : Reduced gates for rapid iteration (dev only)
# - AUDIT_MODE=1   : Full gates + evidence capture + telemetry
# - CI=1           : CI-optimized execution (non-interactive, structured logs)
#
# USAGE:
# - Standard commit: git commit -m "feat: message"
# - Branded commit:  git ps-commit -m "feat: message"
# - Emergency skip:  LEFTHOOK=0 git commit (requires post-facto review)
# - Selective skip:  LEFTHOOK_EXCLUDE=hook_name git commit
#
# PERFORMANCE BASELINE (as of 2025-11-17):
# - P50: 8.2s  | P95: 14.7s  | P99: 22.1s (typical commit with 5-10 files)
# - Target SLO: P95 < 20s for commits with <20 changed files
#
# DEPENDENCIES:
# - Required: gitleaks (brew install gitleaks)
# - Recommended: actionlint, hadolint, markdownlint-cli, commitlint
# - All available via: npm run setup:pre-commit-deps
#
# PARITY WITH CI:
# - Pre-commit hooks mirror GitHub Actions `.github/workflows/ci.yml`
# - Ensures local validation matches CI gating (fail-fast principle)
#
# =============================================================================

min_version: 1.7.0  # Updated for enhanced glob support and telemetry

pre-commit:
  parallel: true
  
  commands:
    # =========================================================================
    # PHASE 0: INITIALIZATION & TELEMETRY (Priority -100)
    # =========================================================================
    
    init-telemetry:
      priority: -100
      run: |
        export HOOK_START_TIME=$(date +%s)
        export HOOK_TRACE_ID=$(uuidgen 2>/dev/null || echo "trace-$(date +%s)")
        echo "HOOK_START_TIME=$HOOK_START_TIME" >> "${TMPDIR:-/tmp}/lefthook-$$-env"
        echo "HOOK_TRACE_ID=$HOOK_TRACE_ID" >> "${TMPDIR:-/tmp}/lefthook-$$-env"
        
        # Detect execution context
        if [ "${FAST_AI}" = "1" ]; then
          export EXECUTION_MODE="fast-secure"
        elif [ "${AUDIT_MODE}" = "1" ]; then
          export EXECUTION_MODE="audit"
        elif [ "${CI}" = "true" ] || [ "${CI}" = "1" ]; then
          export EXECUTION_MODE="ci"
        else
          export EXECUTION_MODE="safe"
        fi
        
        echo "🔍 Pre-commit validation (mode: ${EXECUTION_MODE}, trace: ${HOOK_TRACE_ID})"
        echo ""
        
        # Log hook invocation for observability
        if command -v jq >/dev/null 2>&1; then
          echo "{\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"trace_id\":\"${HOOK_TRACE_ID}\",\"mode\":\"${EXECUTION_MODE}\",\"event\":\"hook_start\"}" \
            >> logs/pre-commit-telemetry.jsonl 2>/dev/null || true
        fi
    
    # =========================================================================
    # PHASE 1: CRITICAL SECURITY GATES (Priority 0 - BLOCKING)
    # All failures in this phase MUST block commit
    # =========================================================================
    
    # 1.1 Secret Scanning (MANDATORY - never skip in production)
    secrets-scan:
      priority: 0
      run: |
        echo "🔒 [P0] Scanning for leaked secrets..."
        
        if ! command -v gitleaks >/dev/null 2>&1; then
          echo "❌ CRITICAL: gitleaks not installed"
          echo ""
          echo "Gitleaks is MANDATORY for secret scanning (OWASP ASVS V2.10)"
          echo "Install: brew install gitleaks"
          echo ""
          echo "Emergency bypass (NOT recommended, requires post-review):"
          echo "  LEFTHOOK_EXCLUDE=secrets-scan git commit"
          exit 1
        fi
        
        # Run gitleaks with fail-closed policy
        if ! gitleaks protect --staged --verbose --redact --exit-code 1; then
          echo ""
          echo "❌ SECRET LEAK DETECTED"
          echo ""
          echo "IMMEDIATE ACTION REQUIRED:"
          echo "1. Remove the secret from staged files"
          echo "2. Rotate/revoke the leaked credential immediately"
          echo "3. Update secret storage (environment variables, vault)"
          echo ""
          echo "For false positives, update .gitleaks.toml allowlist with justification"
          echo ""
          echo "See: docs/06-security-and-risk/security.md#secrets-management"
          exit 1
        fi
        
        echo "✅ No secrets detected"
    
    # 1.2 Dependency Vulnerability Scan (HIGH priority)
    dependency-security:
      priority: 0
      glob: '{package.json,package-lock.json,pnpm-lock.yaml,yarn.lock}'
      run: |
        if git diff --cached --name-only | grep -qE 'package.*\.json|.*lock.*'; then
          echo "📦 [P0] Scanning dependencies for vulnerabilities..."
          
          # Fast check first (local cache)
          if npm audit --audit-level=high --production --json > /tmp/npm-audit-$$.json 2>&1; then
            echo "✅ No high/critical vulnerabilities"
            rm -f /tmp/npm-audit-$$.json
          else
            AUDIT_RESULT=$?
            
            # Parse vulnerability count
            VULN_COUNT=$(jq -r '.metadata.vulnerabilities.high + .metadata.vulnerabilities.critical' \
              /tmp/npm-audit-$$.json 2>/dev/null || echo "unknown")
            
            echo ""
            echo "❌ High/Critical vulnerabilities detected (count: ${VULN_COUNT})"
            echo ""
            echo "REMEDIATION:"
            echo "  npm audit fix           # Auto-fix compatible updates"
            echo "  npm audit fix --force   # Force breaking updates (review carefully)"
            echo "  npm audit               # View full report"
            echo ""
            echo "For known acceptable risks, document in docs/06-security-and-risk/accepted-risks.md"
            echo ""
            
            rm -f /tmp/npm-audit-$$.json
            
            # Allow bypass in FAST_AI mode (with warning)
            if [ "${FAST_AI}" = "1" ]; then
              echo "⚠️  FAST_AI mode: vulnerability check bypassed (NOT for production commits)"
              exit 0
            fi
            
            exit 1
          fi
        fi
    
    # 1.3 License Compliance (ADVISORY - logs but doesn't block)
    license-compliance:
      priority: 0
      glob: 'package.json'
      run: |
        if git diff --cached --name-only | grep -q 'package.json'; then
          echo "⚖️  [P0] Checking license compatibility..."
          
          # Allowlist: permissive licenses compatible with project
          ALLOWED_LICENSES="MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0;Unlicense"
          
          if command -v npx >/dev/null 2>&1; then
            if npx license-checker \
              --onlyAllow "${ALLOWED_LICENSES}" \
              --excludePrivatePackages \
              --summary 2>/dev/null; then
              echo "✅ All licenses compatible"
            else
              echo "⚠️  Incompatible licenses detected"
              echo ""
              echo "Review: npx license-checker --summary"
              echo "Allowed: ${ALLOWED_LICENSES}"
              echo ""
              echo "For exceptions, update allowlist with legal review documentation"
              echo "This is advisory - commit will proceed"
            fi
          else
            echo "⚠️  license-checker not available (install: npm i -g license-checker)"
          fi
        fi
    
    # =========================================================================
    # PHASE 2: CODE QUALITY & FORMATTING (Priority 1 - Auto-fix + Block)
    # Auto-fix where possible, block on unfixable issues
    # =========================================================================
    
    # 2.1 Code Formatting (auto-fix with stage)
    format-code:
      priority: 1
      glob: '*.{ts,tsx,js,jsx,json,css,scss,md,yml,yaml}'
      run: |
        echo "🎨 [P1] Formatting code..."
        
        # Prefer Biome (faster), fallback to Prettier
        if command -v biome >/dev/null 2>&1; then
          biome format --write {staged_files} 2>&1 | grep -v "Processed" || true
          echo "✅ Formatted with Biome"
        else
          npx prettier --write --log-level warn {staged_files}
          echo "✅ Formatted with Prettier"
        fi
      stage_fixed: true
    
    # 2.2 Linting (auto-fix + strict validation)
    lint-code:
      priority: 1
      glob: '*.{ts,tsx,js,jsx}'
      run: |
        echo "🔍 [P1] Linting code..."
        
        # Biome fast pass (optional)
        if command -v biome >/dev/null 2>&1; then
          biome check --apply {staged_files} 2>/dev/null || true
        fi
        
        # ESLint strict validation (zero warnings)
        if ! npx eslint --fix --max-warnings 0 {staged_files}; then
          echo ""
          echo "❌ ESLint errors or warnings detected"
          echo ""
          echo "Fix automatically: npx eslint --fix {staged_files}"
          echo "Review errors: npx eslint {staged_files}"
          echo ""
          echo "Note: --max-warnings 0 enforces zero tolerance policy"
          exit 1
        fi
        
        echo "✅ Lint checks passed"
      stage_fixed: true
    
    # 2.3 TypeScript Type Checking (incremental for performance)
    typecheck:
      priority: 1
      glob: '*.{ts,tsx}'
      run: |
        if [ -n "{staged_files}" ]; then
          echo "🔍 [P1] Type-checking TypeScript..."
          
          # Incremental check for speed
          if ! npx tsc --noEmit --skipLibCheck --incremental; then
            echo ""
            echo "❌ TypeScript type errors detected"
            echo ""
            echo "Fix type errors before committing (strict mode enforced)"
            echo "Run: npx tsc --noEmit"
            echo ""
            echo "See: docs/05-engineering-and-devops/languages/typescript.md"
            exit 1
          fi
          
          echo "✅ Type checks passed (strict mode)"
        fi
    
    # =========================================================================
    # PHASE 3: GOVERNANCE & COMPLIANCE (Priority 2 - MANDATORY)
    # Constitutional, accessibility, and ethical requirements
    # =========================================================================
    
    # 3.1 Accessibility Validation (WCAG 2.2 AA - MANDATORY)
    accessibility-check:
      priority: 2
      glob: '*.{tsx,jsx,html}'
      run: |
        echo "♿ [P2] Validating accessibility (WCAG 2.2 AA)..."
        
        # Comprehensive jsx-a11y rules (beyond default)
        A11Y_RULES="jsx-a11y/alt-text:error,\
jsx-a11y/aria-props:error,\
jsx-a11y/aria-proptypes:error,\
jsx-a11y/aria-role:error,\
jsx-a11y/aria-unsupported-elements:error,\
jsx-a11y/role-has-required-aria-props:error,\
jsx-a11y/role-supports-aria-props:error,\
jsx-a11y/label-has-associated-control:error,\
jsx-a11y/no-noninteractive-element-interactions:error,\
jsx-a11y/no-static-element-interactions:error,\
jsx-a11y/interactive-supports-focus:error,\
jsx-a11y/click-events-have-key-events:error,\
jsx-a11y/no-autofocus:warn,\
jsx-a11y/heading-has-content:error,\
jsx-a11y/html-has-lang:error,\
jsx-a11y/img-redundant-alt:error,\
jsx-a11y/no-redundant-roles:error"
        
        if ! npx eslint --plugin jsx-a11y --rule "${A11Y_RULES}" {staged_files}; then
          echo ""
          echo "❌ ACCESSIBILITY VIOLATIONS DETECTED"
          echo ""
          echo "WCAG 2.2 AA compliance is MANDATORY per constitutional requirements"
          echo ""
          echo "See: docs/05-engineering-and-devops/ui/ux-accessibility.md"
          echo "     docs/00-foundation/standards/standards-overview.md"
          echo ""
          echo "Common fixes:"
          echo "  - Add alt text to <img> elements"
          echo "  - Use semantic HTML (<button>, not <div onClick>)"
          echo "  - Ensure ARIA props are valid and associated"
          echo "  - Add keyboard event handlers alongside mouse events"
          exit 1
        fi
        
        echo "✅ Accessibility checks passed (WCAG 2.2 AA)"
    
    # 3.2 Test Quality Gates
    test-quality-gates:
      priority: 2
      glob: '*.{test,spec}.{ts,tsx,js,jsx,mjs}'
      run: |
        echo "🧪 [P2] Validating test quality..."
        
        VIOLATIONS=0
        
        # Check 1: No .only() in tests (blocks CI)
        if grep -rn "\\<only\\>(" {staged_files} 2>/dev/null; then
          echo "❌ .only() detected in tests (blocks CI execution)"
          VIOLATIONS=$((VIOLATIONS + 1))
        fi
        
        # Check 2: No .skip() without justification
        SKIPPED=$(grep -rn "\\<skip\\>(" {staged_files} 2>/dev/null | wc -l)
        if [ "$SKIPPED" -gt 0 ]; then
          echo "⚠️  $SKIPPED skipped tests detected (review needed)"
          echo "   Add TODO comment with issue reference for each .skip()"
        fi
        
        # Check 3: Ensure tests have assertions
        for file in {staged_files}; do
          if [ -f "$file" ]; then
            if grep -q "\\(describe\\|it\\|test\\)" "$file" 2>/dev/null; then
              if ! grep -q "expect(" "$file" 2>/dev/null; then
                echo "⚠️  Test file without assertions: $file"
              fi
            fi
          fi
        done
        
        # Check 4: No commented-out tests (code smell)
        if grep -rn "// *\\(it\\|test\\|describe\\)" {staged_files} 2>/dev/null; then
          echo "⚠️  Commented-out tests detected (consider removal or re-enabling)"
        fi
        
        if [ $VIOLATIONS -gt 0 ]; then
          echo ""
          echo "Remove .only() and .skip() before committing"
          exit 1
        fi
        
        echo "✅ Test quality checks passed"
    
    # 3.3 Documentation Linting (Markdown quality)
    docs-lint:
      priority: 2
      glob: '*.{md,mdx}'
      run: |
        echo "📝 [P2] Linting documentation..."
        
        # markdownlint for consistency
        if command -v markdownlint >/dev/null 2>&1; then
          if markdownlint {staged_files} --config .markdownlintrc 2>/dev/null; then
            echo "✅ Markdown lint passed"
          else
            echo "⚠️  Markdown linting issues detected"
            echo "   Auto-fix: markdownlint --fix {staged_files}"
            echo "   This is advisory in FAST_AI mode"
            
            if [ "${FAST_AI}" != "1" ]; then
              exit 1
            fi
          fi
        else
          # Basic checks without markdownlint
          for file in {staged_files}; do
            if [ -f "$file" ]; then
              # Check for common issues
              if grep -qE "^#[^#[:space:]]" "$file"; then
                echo "⚠️  Missing space after # in: $file"
              fi
            fi
          done
          
          echo "ℹ️  markdownlint not installed (npm i -g markdownlint-cli for full validation)"
        fi
    
    # 3.4 AI Governance - Political Neutrality Check
    ai-neutrality-check:
      priority: 2
      glob: '*.{ts,tsx,js,jsx,md}'
      run: |
        echo "⚖️  [P2] Checking political neutrality..."
        
        # Fast heuristic check for political bias patterns
        BIAS_PATTERNS="liberal|conservative|left-wing|right-wing|socialist|capitalist|democrat|republican"
        BIAS_CONTEXT="party|ideology|political.*lean|bias.*toward"
        
        FLAGGED=0
        for file in {staged_files}; do
          if [ -f "$file" ] && [ "$file" != "*.md" ]; then
            # Check for bias keywords in non-comment, non-test contexts
            if grep -iE "(${BIAS_PATTERNS})" "$file" 2>/dev/null | \
               grep -viE "(test|spec|example|mock|fixture|\/\/|\/\*|\*\/)" | \
               grep -qiE "(${BIAS_CONTEXT})"; then
              echo "⚠️  Potential political bias detected in: $file"
              echo "   Review context for neutrality compliance"
              FLAGGED=$((FLAGGED + 1))
            fi
          fi
        done
        
        if [ $FLAGGED -gt 0 ]; then
          echo ""
          echo "⚠️  $FLAGGED file(s) flagged for manual neutrality review"
          echo ""
          echo "Constitutional requirement: Absolute political neutrality"
          echo "See: docs/02-governance/constitutional-framework.md"
          echo ""
          echo "If false positive, add neutrality justification comment"
          echo "If genuine bias, refactor to use neutral language/data"
          echo ""
          
          # Advisory only (manual review required, but doesn't block)
          echo "This is advisory - commit proceeds with review flag"
        else
          echo "✅ No neutrality concerns detected"
        fi
    
    # =========================================================================
    # PHASE 4: INFRASTRUCTURE VALIDATION (Priority 3 - Conditional)
    # =========================================================================
    
    # GitHub Actions validation
    actionlint:
      priority: 3
      glob: '.github/workflows/*.{yml,yaml}'
      run: |
        if command -v actionlint >/dev/null 2>&1; then
          echo "⚙️  Validating GitHub Actions..."
          actionlint {staged_files} || {
            echo ""
            echo "❌ GitHub Actions validation failed"
            echo "Fix workflow syntax errors"
            echo "Install: brew install actionlint"
            exit 1
          }
        else
          echo "⚠️  actionlint not installed (brew install actionlint)"
        fi
    
    # Docker linting
    hadolint:
      priority: 3
      glob: '{**/Dockerfile*,**/*.dockerfile}'
      run: |
        if command -v hadolint >/dev/null 2>&1; then
          echo "🐳 Linting Dockerfiles..."
          hadolint --ignore DL3008 --ignore DL3009 {staged_files} || {
            echo ""
            echo "❌ Dockerfile linting failed"
            echo "Fix Dockerfile issues"
            echo "Install: brew install hadolint"
            exit 1
          }
        else
          echo "⚠️  hadolint not installed (brew install hadolint)"
        fi
    
    # Validate JSON
    validate-json:
      priority: 3
      glob: '*.json'
      run: |
        for file in {staged_files}; do
          jq empty "$file" 2>/dev/null || {
            echo "❌ Invalid JSON in $file"
            exit 1
          }
        done
    
    # Validate YAML
    validate-yaml:
      priority: 3
      glob: '*.{yml,yaml}'
      run: |
        if command -v yamllint >/dev/null 2>&1; then
          yamllint --strict {staged_files} 2>/dev/null || true
        fi

# =============================================================================
# PRE-PUSH HOOKS
# =============================================================================

pre-push:
  parallel: false
  
  commands:
    # Full type check
    full-type-check:
      run: |
        echo "🔍 Running full TypeScript type check..."
        npx tsc --noEmit || {
          echo ""
          echo "❌ TypeScript type errors found"
          echo "Fix all type errors before pushing"
          echo "Run: npx tsc --noEmit"
          exit 1
        }
    
    # Run tests on changed files
    test-changed:
      run: |
        echo "🧪 Running tests on changed files..."
        npm run test:changed || {
          echo ""
          echo "❌ Tests failed"
          echo "Fix failing tests before pushing"
          echo "Run: npm run test:changed"
          exit 1
        }
    
    # Dependency security audit
    audit:
      run: |
        echo "🔒 Running security audit..."
        npm audit --audit-level=moderate || {
          echo ""
          echo "⚠️  Security vulnerabilities found"
          echo "Review: npm audit"
          echo "Fix: npm audit fix"
          echo "Note: This is a warning - push will proceed"
        }
    
    # Update AI index
    ai-index:
      run: |
        if [ -f tools/scripts/ai/update-recent-changes.js ]; then
          echo "📝 Updating AI index..."
          node tools/scripts/ai/update-recent-changes.js || {
            echo "⚠️  AI index update failed (non-blocking)"
            echo "This won't prevent pushing"
          }
        fi
    
    # Branch protection awareness
    branch-protection:
      run: |
        BRANCH=$(git branch --show-current)
        
        if [[ "$BRANCH" == "main" ]]; then
          echo "⚠️  You are pushing directly to main"
          echo "Consider using a feature branch:"
          echo "  git checkout -b feature/your-feature"
          echo ""
          echo "Press Ctrl+C to cancel or wait 3 seconds to continue..."
          sleep 3
        fi

# =============================================================================
# COMMIT MESSAGE HOOKS
# =============================================================================

commit-msg:
  commands:
    conventional-commits:
      run: |
        MSG=$(cat {1})
        
        # Check for empty or whitespace-only message
        if [ -z "$MSG" ] || ! echo "$MSG" | grep -q '[^[:space:]]'; then
          echo "❌ Empty commit message"
          echo ""
          echo "Commit messages are required and must not be empty"
          echo "Use Conventional Commits format:"
          echo "  feat(scope): add new feature"
          echo "  fix(scope): bug fix"
          echo "  docs: update documentation"
          exit 1
        fi
        
        # Check for minimum message length
        MSG_NO_WHITESPACE=$(echo "$MSG" | tr -d '[:space:]]')
        if [ ${#MSG_NO_WHITESPACE} -lt 10 ]; then
          echo "❌ Commit message too short"
          echo ""
          echo "Minimum 10 characters required (excluding whitespace)"
          echo "Your message has ${#MSG_NO_WHITESPACE} characters"
          echo ""
          echo "Provide a descriptive commit message explaining the change"
          exit 1
        fi
        
        # Conventional Commits validation
        if ! echo "$MSG" | grep -qE "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?: .{1,}"; then
          echo "❌ Invalid commit message format"
          echo ""
          echo "Use Conventional Commits:"
          echo "  feat(scope): add new feature"
          echo "  fix(scope): bug fix"
          echo "  docs: update documentation"
          echo ""
          echo "Types: feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
          echo ""
          echo "Your message:"
          echo "  $MSG"
          exit 1
        fi
        
        # Check message length
        TITLE=$(echo "$MSG" | head -n 1)
        if [ ${#TITLE} -gt 100 ]; then
          echo "❌ Commit title too long (${#TITLE} > 100 characters)"
          echo "Keep title under 100 characters"
          exit 1
        fi
        
        # Block WIP commits on main branch
        BRANCH=$(git branch --show-current)
        if [[ "$BRANCH" == "main" ]] && echo "$MSG" | grep -iqE "^(wip|WIP|fixup|squash)"; then
          echo "❌ WIP commits not allowed on main branch"
          echo "Finish your work before committing to main"
          echo "Or use a feature branch: git checkout -b feature/your-feature"
          exit 1
        fi
        
        # Check for required issue reference (advisory)
        if ! echo "$MSG" | grep -qE "#[0-9]+|Closes #[0-9]+|Fixes #[0-9]+"; then
          echo "⚠️  Consider referencing an issue: #123 or Closes #123"
        fi

