{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "docs",
  "projectType": "application",
  "tags": ["docs"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Documentation is markdown-based, no build required'"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Documentation can be viewed directly or via docs site generator'"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run docs:lint"
      }
    }
  }
}
