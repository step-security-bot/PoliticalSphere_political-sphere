{
  "name": "political-sphere",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev:api": "cd apps/api && npx tsx watch src/index.ts",
    "dev:web": "cd apps/web && npm run dev",
    "start:api": "cd apps/api && npx tsx src/index.ts",
    "start:web": "cd apps/web && npm run dev",
    "preflight": "npm run lint --if-present && npm run test:allow-failures --if-present && npm run build --if-present",
    "fast-secure": "npm run preflight && npm run security:scan",
    "audit": "SKIP_NPM_AUDIT=true SKIP_TSC=true SKIP_ESLINT=true bash scripts/ci/audit-central.sh all",
    "audit:fix": "AUTO_FIX=true SKIP_NPM_AUDIT=false SKIP_TSC=true bash scripts/ci/audit-central.sh all",
    "audit:full": "bash scripts/ci/audit-central.sh all",
    "audit:full:fix": "AUTO_FIX=true GENERATE_SARIF=true bash scripts/ci/audit-central.sh all",
    "audit:sarif": "GENERATE_SARIF=true bash scripts/ci/audit-central.sh all",
    "audit:github": "bash scripts/ci/audit-central.sh github",
    "audit:devcontainer": "bash scripts/ci/audit-central.sh devcontainer",
    "audit:openapi": "bash scripts/ci/audit-central.sh openapi",
    "audit:apps": "SKIP_NPM_AUDIT=true SKIP_TSC=true SKIP_ESLINT=true bash scripts/ci/audit-central.sh apps",
    "audit:apps:fix": "AUTO_FIX=true SKIP_NPM_AUDIT=false SKIP_TSC=true bash scripts/ci/audit-central.sh apps",
    "audit:api": "bash scripts/ci/app-audit-api.sh",
    "audit:api:fix": "AUTO_FIX=true APP_NAME=api bash scripts/ci/app-audit-api.sh",
    "audit:web": "bash scripts/ci/app-audit-web.sh",
    "audit:web:fix": "AUTO_FIX=true APP_NAME=web bash scripts/ci/app-audit-web.sh",
    "audit:worker": "bash scripts/ci/app-audit-worker.sh",
    "audit:worker:fix": "AUTO_FIX=true APP_NAME=worker bash scripts/ci/app-audit-worker.sh",
    "audit:e2e": "bash scripts/ci/app-audit-e2e.sh",
    "audit:e2e:fix": "AUTO_FIX=true APP_NAME=e2e bash scripts/ci/app-audit-e2e.sh",
    "audit:load-test": "bash scripts/ci/app-audit-load-test.sh",
    "audit:load-test:fix": "AUTO_FIX=true APP_NAME=load-test bash scripts/ci/app-audit-load-test.sh",
    "audit:infrastructure": "bash scripts/ci/app-audit-infrastructure.sh",
    "audit:infrastructure:fix": "AUTO_FIX=true APP_NAME=infrastructure bash scripts/ci/app-audit-infrastructure.sh",
    "openapi-audit": "bash scripts/ci/openapi-audit-fast.sh",
    "openapi-audit:fix": "AUTO_FIX=true bash scripts/ci/openapi-audit-fast.sh",
    "openapi-audit:ci": "SKIP_GENERATOR=true AUTO_FIX=false bash scripts/ci/openapi-audit-fast.sh",
    "devcontainer-audit": "bash scripts/ci/devcontainer-audit.sh",
    "devcontainer-audit:fix": "AUTO_FIX=true bash scripts/ci/devcontainer-audit.sh",
    "github-audit": "bash scripts/ci/github-audit.sh",
    "github-audit:fix": "AUTO_FIX=true bash scripts/ci/github-audit.sh",
    "test": "vitest --run",
    "test:allow-failures": "vitest --run || echo 'Tests completed with failures - proceeding with preflight'",
    "test:changed": "CI=0 VITEST_CHANGED=1 vitest --run --changed",
    "test:fast": "CI=0 VITEST_CHANGED=1 vitest --run --changed",
    "test:full": "npx vitest --run",
    "test:shared": "VITEST_SCOPE=shared VITEST_CHANGED=0 vitest --run --coverage",
    "test:api": "npx vitest --run 'apps/api/**/*.{test,spec}.{js,mjs,ts,tsx}'",
    "test:a11y:components": "vitest --run libs/ui/accessibility/src/*a11y*.test.tsx",
    "test:per-app": "node scripts/test-per-app.js",
    "watch:lint": "onchange 'src/**/*.{ts,tsx,js,jsx}' -- npm run lint",
    "watch:test": "onchange 'src/**/*.{ts,tsx,js,jsx}' -- npm run test:changed",
    "watch:build": "nodemon --watch src --ext ts,tsx,js,jsx --exec 'npm run build:all'",
    "test:ci": "VITEST_CHANGED=0 vitest --run --coverage",
    "test:integration": "vitest --run 'tools/scripts/ai/ai-system.integration.test.js'",
    "test:ai-integration": "vitest --run 'tools/scripts/ai/ai-system.integration.test.js'",
    "test:coverage": "node scripts/run-vitest-coverage.js",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --cache --cache-location node_modules/.cache/eslint/.eslintcache --max-warnings 0",
    "lint:ci": "eslint . --ext .ts,.tsx,.js,.jsx --cache --cache-location node_modules/.cache/eslint/.eslintcache --max-warnings 0",
    "lint:affected": "npx nx affected --target=lint --parallel=3 --nx-bail || npm run lint:ci",
    "lint:strict": "eslint . --ext .ts,.tsx,.js,.jsx --cache --cache-location node_modules/.cache/eslint/.eslintcache --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --cache --cache-location node_modules/.cache/eslint/.eslintcache --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "knip": "knip",
    "cleanup": "bash scripts/cleanup-processes.sh",
    "setup:git-alias": "git config alias.ps-commit '!bash scripts/git-ps-commit.sh'",
    "perf:check": "ps aux | grep -E '(Code|node)' | grep -v grep | wc -l && uptime",
    "perf:monitor": "bash scripts/perf-monitor.sh",
    "perf:vscode-profile": "node tools/scripts/vscode-diagnostics.mjs profile-performance",
    "perf:optimize": "bash scripts/optimize-workspace.sh",
    "perf:cache-clear": "rm -rf node_modules/.cache .nx/cache coverage .vitest",
    "perf:cleanup": "bash tools/scripts/vscode-performance-optimizer.sh",
    "perf:full": "npm run cleanup && npm run perf:optimize && npm run perf:cleanup",
    "test:smoke": "playwright test e2e/smoke",
    "test:e2e:local": "npx playwright test --config=apps/e2e/playwright.local.config.ts",
    "test:visual": "node tools/tests/run-visual-regression.mjs",
    "ai": "node tools/scripts/ai/ai-assistant.cjs assist",
    "ai:chat": "node tools/scripts/ai/ai-assistant.cjs interactive",
    "ai:improve": "node tools/scripts/ai/ai-assistant.cjs auto-improve",
    "ai:status": "node tools/scripts/ai/ai-assistant.cjs status",
    "ai:context": "bash tools/scripts/ai/build-context.sh",
    "ai:refresh": "bash tools/scripts/ai/refresh-knowledge.sh",
    "ai:preflight": "FAST_AI=1 npm run ai:status && FAST_AI=1 npm run ai:health && FAST_AI=1 npm run ai:context",
    "ai:index": "node tools/scripts/ai/semantic-indexer.cjs build",
    "ai:search": "node tools/scripts/ai/semantic-indexer.cjs search",
    "ai:ast": "node tools/scripts/ai/ast-analyzer.cjs",
    "ai:cache": "node tools/scripts/ai/smart-cache.cjs",
    "ai:optimize": "node tools/scripts/ai/context-optimizer.cjs",
    "ai:rotate-cache": "bash tools/scripts/ai/rotate-cache.sh",
    "schemas:generate": "node scripts/generate-types.mjs",
    "schemas:validate": "ajv validate -s schemas/json-schema/*.schema.json --all-errors",
    "adr:list": "node scripts/adr-tool.mjs list",
    "adr:new": "node scripts/adr-tool.mjs new",
    "adr:index": "node scripts/adr-tool.mjs index",
    "docs:api": "compodoc -p apps/api/tsconfig.docs.json -d docs/api-reference --coverageTest 50 --coverageTestThresholdFail false --coverageTestShowOnlyFailed",
    "seed:dev": "node scripts/seed-dev.mjs",
    "db:web": "sqlite_web data/political_sphere.db --port 8080",
    "db:studio": "npx -y prisma studio",
    "openapi:sync": "node scripts/openapi-sync.mjs sync",
    "api:test": "newman run tests/postman_collection.json --environment tests/postman_environment.json",
    "api:validate": "spectral lint docs/api/openapi.yaml",
    "api:mock": "prism mock docs/api/openapi.yaml --host 0.0.0.0 --port 4010",
    "openapi:stats": "node scripts/openapi-sync.mjs stats",
    "perf:benchmark": "node scripts/perf-benchmark.mjs run",
    "perf:baselines": "node scripts/perf-benchmark.mjs baselines",
    "perf:update": "node scripts/perf-benchmark.mjs update",
    "perf:clinic": "clinic doctor -- node apps/api/src/index.ts",
    "perf:autocannon": "autocannon -c 100 -d 10 http://localhost:3000/health",
    "perf:artillery": "artillery quick --count 50 --num 10 http://localhost:3000/health",
    "perf:lighthouse": "lighthouse http://localhost:3001 --output html --output-path reports/lighthouse.html",
    "observability:dashboard": "node scripts/observability/generate-dashboard.mjs",
    "observability:metrics": "node scripts/observability/collect-lighthouse-metrics.mjs",
    "observability:metrics:once": "node scripts/observability/collect-lighthouse-metrics.mjs --once",
    "clinic:doctor": "node scripts/observability/clinic-monitor.mjs doctor",
    "clinic:flame": "node scripts/observability/clinic-monitor.mjs flame",
    "clinic:heap": "node scripts/observability/clinic-monitor.mjs heap",
    "clinic:monitor": "node scripts/observability/clinic-monitor.mjs monitor",
    "docs:lint": "markdownlint \"docs/**/*.md\" \"README.md\" --config .markdownlint.json -i \"node_modules/**\" -i \"vendor/**\" -i \"apps/**/node_modules/**\"",
    "docs:lint:fix": "markdownlint \"docs/**/*.md\" \"README.md\" --config .markdownlint.json -i \"node_modules/**\" -i \"vendor/**\" -i \"apps/**/node_modules/**\" --fix",
    "docs:lint:ci": "markdownlint \"docs/**/*.md\" \"README.md\" --config .markdownlint.json -i \"node_modules/**\" -i \"vendor/**\" -i \"apps/**/node_modules/**\" --ignore-rule MD025,MD035",
    "docs:lint:changed": "git diff --name-only --staged --diff-filter=ACM | grep -E '\\.(md|mdx)$' | xargs -r npx markdownlint --config .markdownlint.json",
    "docs:spell": "cspell \"docs/**/*\" --no-progress --config cspell.json",
    "docs:links": "markdown-link-check docs/**/*.md --config .github/workflows/link-check-config.json",
    "docs:validate": "npm run docs:lint && npm run docs:spell && npm run docs:api",
    "docs:build": "npm run docs:api && npm run docs:validate",
    "deps:check": "depcheck",
    "deps:graph": "madge --image deps-graph.png --exclude 'node_modules' src/",
    "code:duplicates": "jscpd --reporters console,html --output reports/duplicates/ apps/ libs/",
    "code:complexity": "npx -y complexity-report src/ --format html > reports/complexity.html",
    "security:audit-ci": "audit-ci --high --critical",
    "security:retire": "retire --path . --outputformat json --outputpath reports/security/retire.json",
    "security:snyk": "snyk test --json-file-output=reports/security/snyk.json",
    "build:all": "npx nx run-many --target=build --all",
    "ai:health": "node tools/scripts/ai/ai-health.mjs",
    "ci:lint-gha": "bash -lc \"node scripts/ci/verify-github-config.mjs && (npx -y actionlint .github/workflows/**/*.yml .github/actions/**/*.yml || true)\"",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:dry-run": "standard-version --dry-run",
    "build": "echo 'Build step - individual apps handle their own builds' && exit 0",
    "build:web": "cd apps/web && vite build",
    "build:api": "cd apps/api && tsc",
    "dev": "npm run docker:up",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev:web\" --names \"api,web\" --prefix name",
    "dev:watch": "npm run dev:full",
    "docker:dev": "npm run docker:up -- --minimal",
    "docker:full": "npm run docker:up -- --monitoring",
    "serve:web": "cd apps/web && vite --port 3001",
    "clean": "npm run perf:cache-clear && npm run cleanup",
    "clean:install": "rm -rf node_modules package-lock.json && npm install",
    "check": "npm run type-check && npm run lint && npm run test:fast",
    "workflow:daily": "node tools/scripts/dev-workflow.js daily",
    "workflow:pre-commit": "node tools/scripts/dev-workflow.js pre-commit",
    "workflow:ci": "node tools/scripts/dev-workflow.js ci",
    "workflow:watch": "node tools/scripts/dev-workflow.js watch",
    "fix": "npm run lint:fix && npm run format",
    "ci:local": "npm run check && npm run build:all",
    "mcp:filesystem": "node apps/dev/mcp-servers/filesystem/index.mjs",
    "mcp:git": "node apps/dev/mcp-servers/git/index.mjs",
    "mcp:github": "node apps/dev/mcp-servers/github/index.mjs",
    "mcp:sqlite": "node apps/dev/mcp-servers/sqlite/index.mjs",
    "mcp:puppeteer": "node apps/dev/mcp-servers/puppeteer/index.mjs",
    "mcp:political-sphere": "node apps/dev/mcp-servers/political-sphere/index.mjs",
    "mcp:ai-assistant": "node apps/dev/ai/ai-assistant/dist/index.js",
    "mcp:microsoft-learn": "node apps/dev/mcp-servers/microsoft-learn/index.mjs",
    "mcp:duckduckgo": "node apps/dev/mcp-servers/duckduckgo/server.mjs",
    "mcp:playwright": "npx -y @playwright/mcp",
    "mcp:chrome-devtools": "npx -y chrome-devtools-mcp",
    "mcp:filesystem-official": "npx -y @modelcontextprotocol/server-filesystem .",
    "mcp:time": "npx -y time-mcp",
    "mcp:weather": "node tools/mcp-servers/weather/server.mjs",
    "mcp:calculator": "node tools/mcp-servers/calculator/server.mjs",
    "mcp:time-custom": "node tools/mcp-servers/time/server.mjs",
    "mcp:news": "node tools/mcp-servers/news/server.mjs",
    "mcp:performance": "node tools/mcp-servers/performance/server.mjs",
    "mcp:security": "node tools/mcp-servers/security/server.mjs",
    "mcp:git-advanced": "npx -y @cyanheads/git-mcp-server",
    "mcp:nx": "npx -y nx-mcp",
    "mcp:sentry": "npx -y @sentry/mcp-server",
    "mcp:filesystem-enhanced": "npx -y @modelcontextprotocol/server-filesystem .",
    "type-check:affected": "npx nx affected --target=type-check --parallel=3 --nx-bail || npm run type-check"
  },
