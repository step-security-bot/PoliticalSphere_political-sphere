    "@types/sqlite3": "5.1.0",
    "@vitejs/plugin-react": "5.1.1",
    "bcrypt": "6.0.0",
    "compression": "1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "csrf-csrf": "4.0.3",
    "dompurify": "3.3.0",
    "dotenv": "17.2.3",
    "express": "5.1.0",
