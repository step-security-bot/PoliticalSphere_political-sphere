# Development .env for Political Sphere - DO NOT COMMIT SECRETS
# Use this file for local development only. Values are safe defaults for dev.

# PostgreSQL Database Configuration
POSTGRES_USER=political
POSTGRES_PASSWORD=changeme
POSTGRES_DB=political_dev
POSTGRES_PORT=15432
DATABASE_URL=postgresql://political:changeme@localhost:15432/political_dev

# Prisma Connection Pool Settings (PostgreSQL only)
PRISMA_CONNECTION_POOL_SIZE=10
PRISMA_CONNECTION_IDLE_TIMEOUT=300000
PRISMA_CONNECTION_MAX_LIFETIME=600000

REDIS_PASSWORD=changeme
REDIS_PORT=6379

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_PORT=8080

API_PORT=4000
FRONTEND_PORT=3000
PGADMIN_EMAIL=admin@political-sphere.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025
LOCALSTACK_PORT=4566

JWT_SECRET=dev-secret-change-in-production
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Developer overrides
# Example: export DOCKER_DESKTOP_MEM=8192
