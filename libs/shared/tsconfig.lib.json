{
  "extends": "../../tools/config/tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": true,
    "baseUrl": ".",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "types": ["node"],
    "module": "ES2022",
    "moduleResolution": "Node",
    "target": "ES2022",
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["jest.config.js", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
