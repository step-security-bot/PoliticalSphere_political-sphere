 // Prisma schema for Political Sphere
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:./test.db"
}

// Parliament Models
model Chamber {
  id        String   @id @default(cuid())
  gameId    String
  name      String
  type      String // "commons" | "lords"
  maxSeats  Int
  quorumPercentage Float   @default(50.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  motions Motion[]
  debates Debate[]

  @@index([gameId])
  @@map("chambers")
}

model Motion {
  id          String   @id @default(cuid())
  gameId      String
  chamberId   String
  proposerId  String
  type        String // "debate" | "vote" | "amendment" | "procedural"
  title       String
  description String?
  status      String   @default("proposed") // "proposed" | "debate" | "voting" | "completed"
  votingStarted DateTime?
  votingEnded DateTime?
  result      String? // "passed" | "failed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chamber Chamber @relation(fields: [chamberId], references: [id], onDelete: Cascade)
  debate  Debate?

  @@index([gameId])
  @@index([chamberId])
  @@index([chamberId, status])

  @@map("motions")
}

model Debate {
  id          String    @id @default(cuid())
  gameId      String
  motionId    String    @unique
  chamberId   String
  startTime   DateTime
  duration    Int // seconds
  speakingOrder String // JSON array of user IDs
  timePerSpeaker Int @default(180) // seconds
  status      String    @default("scheduled") // "scheduled" | "active" | "completed"
  currentSpeakerIndex Int @default(0)
  speeches    Json? // array of speech objects
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  motion  Motion  @relation(fields: [motionId], references: [id], onDelete: Cascade)
  chamber Chamber @relation(fields: [chamberId], references: [id], onDelete: Cascade)
  votes   DebateVote[]

  @@index([gameId])
  @@index([motionId])
  @@index([chamberId])
  @@index([chamberId, status])

  @@map("debates")
}

model DebateVote {
  id        String   @id @default(cuid())
  gameId    String
  motionId  String
  debateId  String
  userId    String
  vote      String // "aye" | "no" | "abstain"
  createdAt DateTime @default(now())

  debate Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([motionId])
  @@index([debateId])
  @@index([debateId, vote])
  @@unique([motionId, userId])
  @@map("debate_votes")
}

// Government Models
model Government {
  id          String    @id @default(cuid())
  name        String
  leaderId    String?
  status      String    @default("active") // "active" | "dissolved"
  formedAt    DateTime  @default(now())
  dissolvedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ministers Minister[]

  @@index([status])
  @@index([formedAt])
  @@index([leaderId])
  @@map("governments")
}

model Minister {
  id           String    @id @default(cuid())
  userId       String
  governmentId String
  portfolio    String
  appointedAt  DateTime  @default(now())
  resignedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  government Government @relation(fields: [governmentId], references: [id], onDelete: Cascade)

  @@index([governmentId])

  @@map("ministers")
}

model ExecutiveAction {
  id          String    @id @default(cuid())
  title       String
  description String
  type        String // "decree" | "order" | "policy"
  status      String    @default("proposed") // "proposed" | "signed" | "vetoed"
  signedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("executive_actions")
}

model CabinetMeeting {
  id          String   @id @default(cuid())
  title       String
  agenda      String?
  scheduledAt DateTime
  status      String   @default("scheduled") // "scheduled" | "in_progress" | "completed"
  attendees   Json? // array of user IDs
  minutes     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cabinet_meetings")
}

// Judiciary Models
model Case {
  id          String    @id @default(cuid())
  title       String
  description String
  type        String // "constitutional" | "civil" | "criminal"
  status      String    @default("filed") // "filed" | "under_review" | "decided" | "appealed"
  filedAt     DateTime  @default(now())
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rulings Ruling[]
  reviews Review[]

  @@index([status])
  @@index([type])
  @@index([filedAt])
  @@index([status, type])
  @@map("cases")
}

model Judge {
  id          String    @id @default(cuid())
  userId      String
  court       String
  position    String
  appointedAt DateTime  @default(now())
  termEndsAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rulings Ruling[]

  @@index([userId])
  @@index([court])
  @@index([position])
  @@map("judges")
}

model Ruling {
  id        String   @id @default(cuid())
  caseId    String
  judgeId   String
  decision  String
  reasoning String?
  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case  Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  judge Judge @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([judgeId])
  @@index([caseId, judgeId])

  @@map("rulings")
}

model Review {
  id        String    @id @default(cuid())
  caseId    String
  type      String // "appeal" | "judicial_review"
  status    String    @default("pending") // "pending" | "granted" | "denied"
  filedAt   DateTime  @default(now())
  decidedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])

  @@map("reviews")
}

model Precedent {
  id        String   @id @default(cuid())
  caseId    String?
  citation  String   @unique
  summary   String
  holding   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])

  @@map("precedents")
}

// Media Models
model PressRelease {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("press_releases")
}

model Poll {
  id        String   @id @default(cuid())
  question  String
  options   Json // Array of string options
  status    String   @default("active") // "active" | "closed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes PollVote[]

  @@map("polls")
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  userId      String
  optionIndex Int
  votedAt     DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
  @@unique([pollId, userId])
  @@map("poll_votes")
}

model Coverage {
  id          String   @id @default(cuid())
  headline    String
  content     String
  source      String
  bias        Float? // -1 to 1 scale
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("coverage")
}

model Narrative {
  id        String   @id @default(cuid())
  title     String
  content   String
  sentiment String // "positive" | "negative" | "neutral"
  strength  Float // 0-1 scale
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("narratives")
}

model ApprovalRating {
  id         String   @id @default(cuid())
  entityId   String
  entityType String // "government" | "party" | "leader"
  rating     Float // 0-100 scale
  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([entityId, entityType, measuredAt])
  @@map("approval_ratings")
}

// Elections Models
model Election {
  id          String    @id @default(cuid())
  name        String
  type        String // "general" | "by-election" | "local"
  status      String    @default("scheduled") // "scheduled" | "active" | "completed"
  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaigns      Campaign[]
  constituencies Constituency[]
  votes          ElectionVote[]

  @@map("elections")
}

model Campaign {
  id          String   @id @default(cuid())
  electionId  String
  candidateId String
  platform    String?
  budget      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId])

  @@map("campaigns")
}

model Constituency {
  id         String   @id @default(cuid())
  electionId String
  name       String
  region     String
  population Int?
  seats      Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  election   Election    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidates Candidate[]

  @@index([electionId])

  @@map("constituencies")
}

model Candidate {
  id             String   @id @default(cuid())
  constituencyId String
  userId         String
  partyId        String?
  manifesto      String?
  status         String   @default("nominated") // "nominated" | "withdrawn" | "elected"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  constituency Constituency @relation(fields: [constituencyId], references: [id], onDelete: Cascade)

  @@index([constituencyId])

  @@map("candidates")
}

model ElectionVote {
  id             String   @id @default(cuid())
  electionId     String
  constituencyId String
  candidateId    String
  userId         String
  votedAt        DateTime @default(now())

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId])
  @@unique([electionId, userId])
  @@map("election_votes")
}

// Game Models
model Game {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Game state stored as JSON
  state     Json

  @@map("games")
}

// User and Auth Models
enum UserRole {
  ADMIN
  MODERATOR
  VIEWER
}

model User {
   id            String   @id @default(cuid())
   email         String   @unique
   username      String?  @unique
   passwordHash  String?
   role          UserRole @default(VIEWER)
   createdAt     DateTime @default(now())
   updatedAt     DateTime @updatedAt

   // Relations
   proposedBills Bill[]
   votes         Vote[]
   sessions      Session[]
   auditLogs     AuditLog[]

   @@index([username])
   @@index([email])
   @@map("users")
}

// Bill Models
model Bill {
  id          String   @id @default(cuid())
  title       String
  description String?
  proposerId  String
  status      String   @default("proposed")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  proposer User  @relation(fields: [proposerId], references: [id], onDelete: Cascade)
  votes    Vote[]

  @@index([proposerId])
  @@index([status])
  @@index([createdAt])
  @@map("bills")
}

// Party Models
model Party {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now())

  @@index([name])
  @@map("parties")
}

// Vote Models (updated to match bill votes)
model Vote {
   id        String   @id @default(cuid())
   billId    String
   userId    String
   vote      String // "aye" | "nay" | "abstain"
   createdAt DateTime @default(now())

   // Relations
   bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([billId])
   @@index([userId])
   @@index([billId, userId])
   @@unique([billId, userId])
   @@map("votes")
}

// Session Models for user authentication
model Session {
   id           String   @id @default(cuid())
   userId       String
   refreshToken String   @unique
   expiresAt    DateTime
   revokedAt    DateTime?
   createdAt    DateTime @default(now())
   updatedAt    DateTime @updatedAt

   // Relations
   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@index([refreshToken])
   @@index([expiresAt])
   @@map("sessions")
}

// Audit Log Models for compliance
model AuditLog {
   id             String   @id @default(cuid())
   timestamp      DateTime @default(now())
   category       String
   action         String
   userId         String?
   resource       String?
   details        Json?
   ip             String?
   userAgent      String?
   complianceFrameworks Json // Array of framework names
   createdAt      DateTime @default(now())

   // Relations
   user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

   @@index([timestamp])
   @@index([category])
   @@index([userId])
   @@index([action])
   @@map("audit_logs")
}
