{
  "name": "e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/e2e",
  "projectType": "application",
  "tags": ["scope:testing", "type:test"],
  "targets": {
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test",
        "env": {
          "SHARD_INDEX": "1",
          "SHARD_TOTAL": "1"
        }
      },
      "configurations": {
        "ci": {
          "env": {
            "CI": "true",
            "SHARD_INDEX": "{args.shardIndex}",
            "SHARD_TOTAL": "{args.shardTotal}"
          }
        },
        "shard-1": {
          "env": {
            "SHARD_INDEX": "1",
            "SHARD_TOTAL": "4"
          }
        },
        "shard-2": {
          "env": {
            "SHARD_INDEX": "2",
            "SHARD_TOTAL": "4"
          }
        },
        "shard-3": {
          "env": {
            "SHARD_INDEX": "3",
            "SHARD_TOTAL": "4"
          }
        },
        "shard-4": {
          "env": {
            "SHARD_INDEX": "4",
            "SHARD_TOTAL": "4"
          }
        }
      }
    },
    "test:e2e:sharded": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run e2e:test:e2e:shard-1",
          "npx nx run e2e:test:e2e:shard-2",
          "npx nx run e2e:test:e2e:shard-3",
          "npx nx run e2e:test:e2e:shard-4"
        ],
        "parallel": true
      }
    }
  }
}
