# Copy to terraform.tfvars and adjust values before applying.
region        = "us-east-1"
environment   = "prod"

availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

vpc_cidr_block      = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.0.0/24", "10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24", "10.0.12.0/24"]
enable_nat_gateway  = true

primary_domain      = "political-sphere.com"
additional_domains  = ["api.political-sphere.com", "game.political-sphere.com", "www.political-sphere.com"]
route53_zone_name   = "political-sphere.com"

rds_username = "prod_admin"
# Sensitive: provide via environment variable TF_VAR_rds_password or secure secrets manager.
# rds_password = "set-me"

redis_auth_token = ""

kms_administrators = [
  "arn:aws:iam::123456789012:role/platform-admin"
]

kms_users = [
  "arn:aws:iam::123456789012:role/app-runtime"
]

github_org = "political-sphere"
github_repositories = [
  "infrastructure",
  "platform"
]

# github_permissions_boundary = "arn:aws:iam::123456789012:policy/GitHubBoundary"
